<?xml version="1.0" encoding="utf-8"?>
<!--
  墨水屏用的圆形描边按钮背景。
  电纸书对浅色与透明边界不敏感，浮在正文上的圆钮如果只有填充色，
  会完全看不出轮廓、和文字糊在一起，因此统一用描边画出边界。

  填充色与描边色都必须跟随主题：原先写死 @color/white + @color/primaryText，
  夜间主题下就是白底白图标，四个悬浮按钮看上去是四个空白圆点。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?android:attr/colorBackground" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorControlNormal" />
</shape>
