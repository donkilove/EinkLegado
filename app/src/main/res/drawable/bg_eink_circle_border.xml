<?xml version="1.0" encoding="utf-8"?>
<!--
  墨水屏用的圆形描边按钮背景。
  电纸书对浅色与透明边界不敏感，浮在正文上的白色圆钮如果只有填充色，
  会完全看不出轮廓、和文字糊在一起，因此统一用深色描边画出边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/background_menu" />
    <stroke
        android:width="1dp"
        android:color="@color/primaryText" />
</shape>
